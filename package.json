{
  "name": "metaview-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "Candidate sourcing, attrition-risk scoring and automated outreach engine",
  "license": "ISC",
  "type": "commonjs",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "launch-browser": "./scripts/launch_chrome.sh",
    "scrape": "ts-node src/scraper.ts",
    "sync-meili": "ts-node src/sync_meili.ts",
    "backfill-roles": "ts-node src/backfill_latest_roles.ts",
    "api": "npm run dev --workspace backend",
    "api:build": "npm run build --workspace backend",
    "web": "npm run dev --workspace frontend",
    "web:build": "npm run build --workspace frontend",
    "retrieval-service": "cd machine_learning/retrieval_service && uvicorn main:app --host 0.0.0.0 --port 8765 --reload",
    "ingest-embeddings": "python3 machine_learning/retrieval_service/ingest_embeddings.py",
    "migrate": "psql \"postgresql://$DB_USER:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_NAME\" -f src/migrations/002_search_performance.sql",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md,yml}\"",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "dotenv": "^17.4.1",
    "googleapis": "^173.0.0",
    "meilisearch": "^0.57.0",
    "minimist": "^1.2.8",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
