{
  "name": "@metaview/api",
  "version": "1.0.0",
  "description": "Express API, screening and outreach services",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude \"**/integration.test.ts\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "RUN_INTEGRATION=1 vitest run src/integration.test.ts"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@types/minimist": "^1.2.5",
    "@types/nodemailer": "^8.0.0",
    "@types/p-limit": "^2.1.0",
    "bullmq": "^6.0.6",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonrepair": "^3.14.0",
    "meilisearch": "^0.57.0",
    "minimist": "^1.2.8",
    "nodemailer": "^9.0.3",
    "openai": "^6.34.0",
    "p-limit": "^3.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.59.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "pg": "^8.20.0",
    "playwright-extra": "^4.3.6",
    "prettier": "^3.9.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "private": true
}
