DB_HOST=
DB_PORT=
DB_NAME=
# Outreach Agent Settings
OPENAI_API_KEY=
MEILI_URL=
MEILI_KEY=
MEILI_INDEX=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SENDER_NAME=
TEST_TO=
TEST_CC=

# Basic Auth - Change these before deploying
API_USER=
API_PASS=

# Access Control - Whitelist specific external IPs (e.g., from Tailscale)
# You can add multiple IPs by separating them with commas
TAILSCALE_ALLOWED_IP=

NVIDIA_API_KEY=

# Vector Search DB (separate pgvector container, port 5434 — isolated from golden DB)
VECTOR_DB_HOST=
VECTOR_DB_PORT=
VECTOR_DB_NAME=
VECTOR_DB_USER=
VECTOR_DB_PASSWORD=

# Google Sheets / Drive API
GOOGLE_APPLICATION_CREDENTIALS=

# Exposed to the frontend bundle by Vite (envDir=repo root).
# Mirrors MEILI_KEY today; replace with a search-only key when available.
VITE_MEILI_KEY=

# Comma-separated recipients excluded from outreach-history logging.
OUTREACH_BLOCKED_RECIPIENTS=
